<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Reusable Sidebar Component -->

<VBox styleClass="sidebar" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.interviewai.controller.SidebarController">
    <!-- Logo & Branding -->
    <VBox styleClass="sidebar-header">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="sidebar-logo-icon" text="🎯" />
            <VBox spacing="2">
                <Label styleClass="sidebar-logo-text" text="InterviewAI" />
                <Label styleClass="sidebar-logo-subtitle" text="Master Your Journey" />
            </VBox>
        </HBox>
    </VBox>

    <!-- Main Navigation -->
    <VBox styleClass="sidebar-nav-section">
        <Label styleClass="nav-section-title" text="MAIN MENU" />
        <VBox styleClass="sidebar-nav">
            <Button fx:id="dashboardButton" onAction="#onOpenDashboard" prefWidth="220.0" styleClass="nav-button, nav-active">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="🏠" />
                        <Label prefHeight="18.0" prefWidth="92.0" styleClass="nav-label" text="Dashboard" />
                    </HBox>
                </graphic>
            </Button>
            
            <!-- Dynamic Lesson Button - Only shows when chapter is selected -->
            <Button fx:id="lessonButton" managed="false" onAction="#onOpenLesson" prefWidth="220.0" styleClass="nav-button" visible="false">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="📚" />
                        <Label styleClass="nav-label" text="Lesson" />
                    </HBox>
                </graphic>
            </Button>
            
            <Button fx:id="progressButton" onAction="#onOpenProgress" prefWidth="220.0" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" prefHeight="18.0" prefWidth="109.0" spacing="14">
                        <Label styleClass="nav-icon" text="📊" />
                        <Label styleClass="nav-label" text="Progress" />
                    </HBox>
                </graphic>
            </Button>
            
            <Button fx:id="reviewButton" onAction="#onOpenReview" prefHeight="26.0" prefWidth="220.0" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="🔄" />
                        <Label prefHeight="18.0" prefWidth="98.0" styleClass="nav-label" text="Review" />
                    </HBox>
                </graphic>
            </Button>
            
            <Button fx:id="questsButton" onAction="#onOpenQuests" prefWidth="220.0" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="🎯" />
                        <Label prefHeight="18.0" prefWidth="92.0" styleClass="nav-label" text="Quests" />
                    </HBox>
                </graphic>
            </Button>
            <Button fx:id="leaderboardButton" onAction="#onOpenLeaderboards" prefWidth="220.0" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="🏆" />
                        <Label prefHeight="18.0" prefWidth="91.0" styleClass="nav-label" text="Leaderboard" />
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- User Section -->
    <VBox styleClass="sidebar-nav-section">
        <Label styleClass="nav-section-title" text="ACCOUNT" />
        <VBox styleClass="sidebar-nav">
            <Button fx:id="profileButton" onAction="#onOpenProfile" prefWidth="220.0" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="👤" />
                        <Label prefHeight="18.0" prefWidth="91.0"  styleClass="nav-label" text="Profile" />
                    </HBox>
                </graphic>
            </Button>
            <Button fx:id="logoutButton" onAction="#onLogout" prefWidth="220.0" styleClass="nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label styleClass="nav-icon" text="🚪" />
                        <Label prefHeight="18.0" prefWidth="92.0" styleClass="nav-label" text="Logout" />
                    </HBox>
                </graphic>
            </Button>
        </VBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <!-- Sidebar Footer Stats -->
    <VBox styleClass="sidebar-footer">
        <Separator styleClass="sidebar-separator" />
    </VBox>
</VBox>
