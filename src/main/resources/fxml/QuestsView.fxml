<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.interviewai.controller.QuestsController" stylesheets="@../css/quests.css">
    <VBox styleClass="content-wrapper" spacing="30">
        
        <!-- Header -->
        <VBox spacing="8">
            <Label text="Quests &amp; Challenges" styleClass="page-title"/>
            <Label text="Complete quests to earn XP and unlock exclusive badges." styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="30" alignment="TOP_LEFT">
            <!-- Main Content Column -->
            <VBox spacing="30" HBox.hgrow="ALWAYS">
                
                <!-- Daily Quest Card -->
                <VBox styleClass="quest-card, daily-quest-card" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="🔥" styleClass="quest-icon"/>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="DAILY QUEST" styleClass="quest-badge"/>
                            <Label text="Answer 20 Questions" styleClass="quest-title"/>
                            <Label text="Reward: +900 XP" styleClass="quest-reward"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5">
                             <Label fx:id="dailyTimerLabel" text="Ends in --h --m" styleClass="timer-label"/>
                             <Button fx:id="dailyClaimButton" text="Claim Reward" styleClass="claim-button" onAction="#handleClaimDaily"/>
                        </VBox>
                    </HBox>
                    
                    <VBox styleClass="progress-container">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Progress" styleClass="progress-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="dailyQuestProgressLabel" text="0 / 20" styleClass="progress-value"/>
                        </HBox>
                        <ProgressBar fx:id="dailyQuestProgressBar" progress="0.0" maxWidth="Infinity" styleClass="custom-progress-bar"/>
                    </VBox>
                </VBox>

                <!-- Monthly Quest Card -->
                <VBox styleClass="quest-card, monthly-quest-card" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="🏆" styleClass="quest-icon"/>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="MONTHLY QUEST" styleClass="quest-badge"/>
                            <Label text="Complete 12 Chapters" styleClass="quest-title"/>
                            <Label text="Reward: +30,000 XP" styleClass="quest-reward"/>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5">
                             <Label fx:id="monthlyTimerLabel" text="Ends in --d" styleClass="timer-label"/>
                             <Button fx:id="monthlyClaimButton" text="Claim Reward" styleClass="claim-button" onAction="#handleClaimMonthly"/>
                        </VBox>
                    </HBox>
                    
                    <VBox styleClass="progress-container">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Course Completion" styleClass="progress-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="monthlyQuestProgressLabel" text="0 / 12" styleClass="progress-value"/>
                        </HBox>
                        <ProgressBar fx:id="monthlyQuestProgressBar" progress="0.0" maxWidth="Infinity" styleClass="custom-progress-bar"/>
                    </VBox>
                </VBox>

            </VBox>

            <!-- Right Sidebar (Stats) -->
            <VBox spacing="20" minWidth="300" maxWidth="300">
                <VBox styleClass="badges-sidebar" spacing="15">
                    <Label text="Your Stats" styleClass="section-title"/>
                    
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="🔥" style="-fx-font-size: 20px;"/>
                        <VBox>
                            <Label fx:id="streakLabel" text="0 Day Streak" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Label text="Keep it up!" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>
                    
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="⚡" style="-fx-font-size: 20px;"/>
                        <VBox>
                            <Label fx:id="totalXpLabel" text="0 Total XP" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Label text="Lifetime earnings" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>